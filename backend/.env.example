# Required in production — use a long random string (32+ chars)
JWT_SECRET=change-me-to-a-secure-random-string

# Server
PORT=5000
NODE_ENV=development

# Comma-separated allowed origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173

# Face matching: lower = stricter (0.45–0.60 recommended)
FACE_MATCH_THRESHOLD=0.55

# Seconds before the same person is logged again while scanning (default 45)
LOG_COOLDOWN_SECONDS=45
